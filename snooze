## Language
#
# Two languages: German (de) and English (en, default). German only for a
# German system locale (de, de_DE, de_CH, de_AT, de_LI, de_LU, …) — checked
# in the POSIX-standard priority LC_ALL > LC_MESSAGES > LANG. Without a
# recognizable/set locale (or any other language), English applies.
# All translations live in MSG; tr() looks up the current language.
# (Not named 't' — that would collide with the loop variable 't' in
# expand_host_patterns()/split_targets().)


def detect_lang() -> str:
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        val = os.environ.get(var, "").strip()
        if val:
            return "de" if val[:2].lower() == "de" else "en"
    return "en"


