## Machine-readable output (--json)
#
# With --json nothing human-readable goes to stdout: every command collects
# its rows in _ROWS and one JSON document is written at the end. The keys are
# deliberately language-independent - the whole point is that scripts don't
# have to parse output that changes with the locale. Localized text is still
# carried along in "message" for people reading logs, but the machine-facing
# fields ("result", "error", timestamps) never change.

JSON_MODE = False
JSON_COMMAND = ""
_ROWS = []


def _iso(ts) -> str:
    """Unix timestamp as local ISO 8601, including the UTC offset."""
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(int(ts)))


def _row(**fields):
    _ROWS.append(fields)


def emit_json(ok: bool, error: str = None, message: str = None, **extra):
    """Writes the single JSON document a --json run produces."""
    doc = {"version": VERSION, "command": JSON_COMMAND, "ok": ok}
    if error:
        doc["error"] = error
    if message:
        doc["message"] = message
    doc.update(extra)
    doc["results"] = _ROWS
    print(json.dumps(doc, ensure_ascii=False, indent=2))


def _print_ok(target: str, msg: str, **fields):
    if JSON_MODE:
        _row(target=target, result="ok", message=msg, **fields)
        return
    print(f"{tr('lbl_ok'):<8}{target}  {msg}")


def _print_err(target: str, msg: str, error: str = "error", **fields):
    if JSON_MODE:
        _row(target=target, result="error", error=error, message=msg, **fields)
        return
    print(f"{tr('lbl_err'):<8}{target}  {msg}")


