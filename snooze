def die(msg: str, code: int = 1, error: str = None):
    if JSON_MODE:
        # Consumers get parseable output even when the run fails outright.
        emit_json(False, error=error or ("usage" if code == 2 else "error"),
                  message=str(msg))
        sys.exit(code)
    print(f"snooze: {msg}", file=sys.stderr)
    sys.exit(code)


def extract_flags(args: list) -> tuple:
    """Extracts options (-F/--file, -Y/--yes, --reason, --json).

    Returns (positionals, {file, yes, reason}). Everything after '--' is positional."""
    global JSON_MODE
    opts = {"file": None, "yes": False, "reason": None}
    pos = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            pos.extend(args[i + 1:])
            break
        elif a in ("-Y", "--yes"):
            opts["yes"] = True
        elif a == "--json":
            JSON_MODE = True
        elif a in ("-F", "--file"):
            if i + 1 >= len(args):
                die(tr("flag_need_filename", flag=a), code=2)
            opts["file"] = args[i + 1]
            i += 1
        elif a.startswith("--file="):
            opts["file"] = a.split("=", 1)[1]
        elif a == "--reason":
            if i + 1 >= len(args):
                die(tr("flag_need_text"), code=2)
            opts["reason"] = args[i + 1]
            i += 1
        elif a.startswith("--reason="):
            opts["reason"] = a.split("=", 1)[1]
        else:
            pos.append(a)
        i += 1
    return pos, opts


def collect_targets(tokens: list, opts: dict) -> list:
    """Combines CLI tokens with targets from -F/stdin.

    Without -F, stdin is still read automatically if it isn't a TTY (piped or
    redirected) - 'echo host1 host2 | snooze' works without spelling out
    -F -. A TTY is left alone so an interactive shell never blocks waiting
    for input the user never intended to pipe."""
    targets = list(tokens)
    if opts["file"]:
        targets.extend(read_targets_file(opts["file"]))
    elif not sys.stdin.isatty():
        targets.extend(read_targets_file("-"))
    return targets


def _finish_mute(duration: str, target_tokens: list, opts: dict, since=None) -> int:
    """Shared tail of 'mute' and 'plan': resolve targets, confirm, execute."""
    target_tokens = collect_targets(target_tokens, opts)
    host_tokens, groups = split_targets(target_tokens)
    hosts, missing = expand_host_patterns(host_tokens)
    for pat in missing:
        _print_err(pat, tr("no_pattern_match"), error="no_match")
    if not hosts and not groups and not missing:
        hosts = [local_fqdn()]
    if not confirm(len(hosts) + len(groups), opts["yes"]):
        die(tr("aborted"), code=2)
    rc = run_snooze(duration, hosts, groups, reason=opts["reason"], since=since)
    return 1 if missing else rc


def run_mute(tokens: list, opts: dict) -> int:
    if tokens and is_duration(tokens[0]):
        duration = tokens[0]
        target_tokens = tokens[1:]
    else:
        duration = CONFIG["duration"]
        target_tokens = tokens
    return _finish_mute(duration, target_tokens, opts)


def run_plan_cmd(tokens: list, opts: dict) -> int:
    since, rest = _consume_when(tokens)
    if rest and is_duration(rest[0]):
        duration, target_tokens = rest[0], rest[1:]
    else:
        duration, target_tokens = CONFIG["duration"], rest
    return _finish_mute(duration, target_tokens, opts, since=since)


def run_extend_cmd(tokens: list, opts: dict) -> int:
    if not tokens or not is_duration(tokens[0]):
        die(tr("extend_need_duration"), code=2)
    duration = tokens[0]
    target_tokens = collect_targets(tokens[1:], opts)
    host_tokens, groups = split_targets(target_tokens)
    hosts, missing = expand_host_patterns(host_tokens)
    for pat in missing:
        _print_err(pat, tr("no_pattern_match"), error="no_match")
    if not hosts and not groups and not missing:
        hosts = [local_fqdn()]
    rc = run_extend(duration, hosts, groups)
    return 1 if missing else rc


def run_unmute(tokens: list, opts: dict) -> int:
    target_tokens = collect_targets(tokens, opts)
    host_tokens, groups = split_targets(target_tokens)
    hosts, missing = expand_host_patterns(host_tokens)
    for pat in missing:
        _print_err(pat, tr("no_pattern_match"), error="no_match")
    if not hosts and not groups and not missing:
        hosts = [local_fqdn()]
    rc = run_wakeup(hosts, groups)
    return 1 if missing else rc


def run_list_suppressed(tokens: list) -> int:
    """Parses targets for 'list suppressed'; no targets = all active snooze windows."""
    host_tokens, groups = split_targets(tokens)
    hosts, missing = expand_host_patterns(host_tokens)
    for pat in missing:
        _print_err(pat, tr("no_pattern_match"), error="no_match")
    rc = run_suppressed(hosts, groups)
    return 1 if missing else rc


def run_list(subargs: list) -> int:
    """Dispatcher for 'list hosts|groups|active|plans|suppressed'."""
    what = subargs[0] if subargs else ""
    if what == "hosts":
        return list_hosts()
    if what == "groups":
        return list_hostgroups()
    if what == "active":
        return run_status()
    if what == "plans":
        return run_plans()
    if what == "suppressed":
        return run_list_suppressed(subargs[1:])
    die(tr("list_need_subcmd"), code=2)


# Every command the dispatch below recognizes. A first token that isn't one of
# these is treated as a target for an implicit mute.
KNOWN_COMMANDS = ("mute", "plan", "extend", "unmute", "list", "status",
                  "cleanup", "prune")


def main(argv: list) -> int:
    global CONFIG, JSON_COMMAND
    CONFIG = load_config()
    apply_lang_override(CONFIG)

    positionals, opts = extract_flags(argv[1:])
    cmd = positionals[0] if positionals else ""
    # Labels the JSON document with the command that produced it. Anything
    # unrecognized is an implicit mute, same as in the dispatch below.
    JSON_COMMAND = cmd if cmd in KNOWN_COMMANDS else "mute"
    if JSON_COMMAND == "prune":               # alias for 'cleanup'
        JSON_COMMAND = "cleanup"
    elif JSON_COMMAND == "status":            # alias for 'list active'
        JSON_COMMAND = "list active"
    elif JSON_COMMAND == "list" and len(positionals) > 1:
        JSON_COMMAND = f"list {positionals[1]}"

    # help/version never need a configured token - checked before the token
    # gate below, so 'snooze --help' works even with no config/token at all.
    if cmd in ("-h", "--help", "help"):
        if JSON_MODE:
            JSON_COMMAND = "help"
            _row(help=HELP)
            return 0
        print(HELP)
        return 0
    if cmd in ("-V", "--version", "version"):
        if JSON_MODE:
            JSON_COMMAND = "version"
            _row(version=VERSION, author=AUTHOR)
            return 0
        print(f"snooze {VERSION}")
        print(AUTHOR)
        return 0

    if not CONFIG["token"]:
        die(tr("no_token"), error="config")

    if not positionals and not opts["file"]:
        return run_mute([], opts)

    rest = positionals[1:]

    if cmd == "mute":
        return run_mute(rest, opts)
    if cmd == "plan":
        return run_plan_cmd(rest, opts)
    if cmd == "extend":
        return run_extend_cmd(rest, opts)
    if cmd == "unmute":
        return run_unmute(rest, opts)
    if cmd == "list":
        return run_list(rest)
    if cmd == "status":                       # alias for 'list active'
        return run_list(["active"])
    if cmd in ("cleanup", "prune"):
        return run_cleanup()

    # No known command -> implicit mute (positionals as targets).
    return run_mute(positionals, opts)


CONFIG = {}  # populated in main(); default for direct function calls/tests

if __name__ == "__main__":
    try:
        code = main(sys.argv)
        if JSON_MODE:
            emit_json(code == 0)
        sys.exit(code)
    except ZabbixError as exc:
        die(str(exc), error="api_error")
    except KeyboardInterrupt:
        die(tr("aborted"), code=130, error="aborted")
