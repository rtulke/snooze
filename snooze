}


def load_config() -> dict:
    """Reads defaults < first readable config file < environment variables."""
    cfg = dict(DEFAULTS)
    for path in CONFIG_PATHS:
        if os.path.isfile(path):
            parser = configparser.ConfigParser(interpolation=None)
            try:
                parser.read(path)
            except configparser.Error as exc:
                die(tr("cfg_unreadable", path=path, exc=exc), error="config")
            if parser.has_section("snooze"):
                for key in DEFAULTS:
                    if parser.has_option("snooze", key):
                        cfg[key] = parser.get("snooze", key)
            break
    for key, names in ENV_OVERRIDES.items():
        for name in names:
            if os.environ.get(name):
                cfg[key] = os.environ[name]
                break
    return cfg


def apply_lang_override(cfg: dict):
    """Forces 'de'/'en' from config ('lang')/env (SNOOZE_LANG); empty = detect_lang() stands."""
    global LANG, HELP
    override = cfg.get("lang", "").strip().lower()
    if override in ("de", "en"):
        LANG = override
        HELP = HELP_DE if LANG == "de" else HELP_EN


## Duration parsing
#
# Note: lowercase 'm'/'min' = minutes, uppercase 'M' = month (30 days).
DURATION_RE = re.compile(r"^(\d+)(min|m|h|d|w|M)$")
DURATION_UNITS = {
    "min": 60,
    "m": 60,
    "h": 3600,
    "d": 86400,
    "w": 604800,
    "M": 2592000,  # 30 days
}


def is_duration(s: str) -> bool:
    return bool(DURATION_RE.match(s))


def parse_duration(s: str) -> int:
    m = DURATION_RE.match(s)
    if not m:
        die(tr("bad_duration", s=s))
    return int(m.group(1)) * DURATION_UNITS[m.group(2)]


## Scheduled start (snooze plan)
#
# Two formats: 'HH:MM' (today's date; if that time has already passed today,
# that's an error instead of silently rolling over to tomorrow) or
# 'DD.MM.YYYY HH:MM' (leading zeros on day/month optional). Unquoted, date
# and time arrive as two separate tokens ('22.5.2026' '14:00') — DATE_RE
# recognizes the leading date so _consume_when() can join both tokens before
# parse_when() parses the combined string.

DATE_RE = re.compile(r"^(\d{1,2})\.(\d{1,2})\.(\d{4})$")
WHEN_TIME_RE = re.compile(r"^(\d{1,2}):(\d{2})$")
WHEN_DATETIME_RE = re.compile(r"^(\d{1,2})\.(\d{1,2})\.(\d{4})\s+(\d{1,2}):(\d{2})$")


def parse_when(s: str) -> int:
    """Parses 'plan' timestamps ('HH:MM' or 'DD.MM.YYYY HH:MM') into a Unix timestamp."""
    s = s.strip()
    now = time.time()

    m = WHEN_DATETIME_RE.match(s)
    if m:
        day, month, year, hour, minute = (int(g) for g in m.groups())
        try:
            dt = datetime(year, month, day, hour, minute)
        except ValueError as exc:
            die(tr("bad_when_value", s=s, exc=exc), code=2)
        if dt.timestamp() <= now:
            die(tr("when_past", s=s), code=2)
        return int(dt.timestamp())

    m = WHEN_TIME_RE.match(s)
    if m:
        hour, minute = (int(g) for g in m.groups())
        today = time.localtime()
        try:
            dt = datetime(today.tm_year, today.tm_mon, today.tm_mday, hour, minute)
        except ValueError as exc:
            die(tr("bad_when_value", s=s, exc=exc), code=2)
        if dt.timestamp() <= now:
            example = f"{time.strftime('%d.%m.%Y', today)} {s}"
            die(tr("time_already_past_today", s=s, example=example), code=2)
        return int(dt.timestamp())

    die(tr("bad_when_format", s=s), code=2)


def _consume_when(tokens: list) -> tuple:
    """Pulls the timestamp off the start of tokens for 'snooze plan' (one or two tokens).

    Both quoted ('DD.MM.YYYY HH:MM' as one argument) and unquoted (two
    arguments 'DD.MM.YYYY' 'HH:MM') are accepted. Returns (since, rest)."""
    if not tokens:
        die(tr("plan_need_time"), code=2)
    if WHEN_DATETIME_RE.match(tokens[0]):
        return parse_when(tokens[0]), tokens[1:]
    if DATE_RE.match(tokens[0]):
        if len(tokens) < 2 or not WHEN_TIME_RE.match(tokens[1]):
            die(tr("plan_need_time_after_date", date=tokens[0]), code=2)
        return parse_when(f"{tokens[0]} {tokens[1]}"), tokens[2:]
    if WHEN_TIME_RE.match(tokens[0]):
        return parse_when(tokens[0]), tokens[1:]
    die(tr("plan_bad_time", s=tokens[0]), code=2)


## Hostnames

GLOB_CHARS = set("*?[")


def fqdn(name: str) -> str:
    return name if "." in name else f"{name}.{CONFIG['domain']}"


def local_fqdn() -> str:
    """Local FQDN, robust against 'localhost'/short names from getfqdn()."""
    for candidate in (socket.getfqdn(), socket.gethostname()):
        candidate = (candidate or "").strip().lower()
        if candidate and candidate not in ("localhost", "localhost.localdomain"):
            return candidate if "." in candidate else f"{candidate}.{CONFIG['domain']}"
    die(tr("no_local_hostname"))


def is_pattern(token: str) -> bool:
    """True if token is a glob (*?[) or a regex (~ prefix)."""
    return token.startswith("~") or any(c in GLOB_CHARS for c in token)


def split_targets(tokens: list) -> tuple:
    """Splits tokens into hosts/patterns and hostgroups (@ prefix)."""
    hosts, groups = [], []
    for t in tokens:
        if t.startswith("@"):
            groups.append(t[1:])
        else:
            hosts.append(t)
    return hosts, groups


def expand_host_patterns(tokens: list) -> tuple:
    """Resolves globs/regexes against the Zabbix host list. Returns (names, not_found).

    Tokens without a pattern get FQDN-completed and passed through unchanged
    (existence is checked later in resolve_hosts)."""
    literal, patterns = [], []
    for t in tokens:
        (patterns if is_pattern(t) else literal).append(t)
    if not patterns:
        return [fqdn(t) for t in literal], []

    all_hosts = [h["host"] for h in zabbix("host.get", {"output": ["host"]})]
    resolved = [fqdn(t) for t in literal]
    missing = []
    for pat in patterns:
        if pat.startswith("~"):
            try:
                rx = re.compile(pat[1:])
            except re.error as exc:
                die(tr("bad_regex", pat=pat, exc=exc))
            matches = [h for h in all_hosts if rx.search(h)]
        else:
            needle = fqdn(pat)
            matches = fnmatch.filter(all_hosts, needle)
        if matches:
            resolved.extend(matches)
        else:
            missing.append(pat)
    # Order stable and deduplicated.
    seen, ordered = set(), []
    for h in resolved:
        if h not in seen:
            seen.add(h)
            ordered.append(h)
    return ordered, missing


## Zabbix API

class ZabbixError(Exception):
    """API or transport error; handled by callers per-target or globally."""


def zabbix(method: str, params):
    payload = json.dumps({
        "jsonrpc": "2.0",
        "method": method,
        "params": params,
        "id": 1,
    }).encode()
    req = urllib.request.Request(
        CONFIG["url"],
        data=payload,
        headers={
            "Content-Type": "application/json-rpc",
            "Authorization": f"Bearer {CONFIG['token']}",
            "User-Agent": f"snooze/{VERSION}",
        },
    )
    retries = max(0, int(CONFIG["retries"]))
    last_err = None
    for attempt in range(retries + 1):
        try:
            with urllib.request.urlopen(req, timeout=int(CONFIG["timeout"])) as r:
                data = json.loads(r.read())
            break
        except urllib.error.HTTPError as e:
            # HTTP errors (4xx/5xx) are usually not transient -> don't retry.
            raise ZabbixError(f"Zabbix HTTP {e.code}: {e.reason}")
        except urllib.error.URLError as e:
            last_err = e
            if attempt < retries:
                time.sleep(1 + attempt)
                continue
            raise ZabbixError(tr("zbx_unreachable", exc=e))
    if "error" in data:
        e = data["error"]
        raise ZabbixError(tr("zbx_api_error", msg=e.get("message"), data=e.get("data")))
    return data["result"]


def resolve_hosts(hostnames: list) -> dict:
    """Maps FQDN → hostid. Hosts not found → None."""
    res = zabbix("host.get", {
        "filter": {"host": hostnames},
        "output": ["hostid", "host"],
    })
    found = {h["host"]: h["hostid"] for h in res}
    return {n: found.get(n) for n in hostnames}


def resolve_groups(groupnames: list) -> dict:
    """Maps group name → groupid. Not found → None."""
    res = zabbix("hostgroup.get", {
        "filter": {"name": groupnames},
        "output": ["groupid", "name"],
    })
    found = {g["name"]: g["groupid"] for g in res}
    return {n: found.get(n) for n in groupnames}


def get_maintenance(name: str):
    """Returns the (first) maintenance object with this name, or None."""
    res = zabbix("maintenance.get", {
        "filter": {"name": name},
        "output": ["maintenanceid", "active_since", "active_till"],
    })
    return res[0] if res else None


def list_hosts() -> int:
    """Lists all hosts from Zabbix (technical name + visible name)."""
    res = zabbix("host.get", {"output": ["host", "name"]})
    if not res:
        if not JSON_MODE:
            print(tr("no_hosts_found"))
        return 0
    for h in sorted(res, key=lambda x: x["host"].lower()):
        host = h["host"]
        name = h.get("name", "")
        if JSON_MODE:
            _row(host=host, name=name)
            continue
        print(f"{host}  ({name})" if name and name != host else host)
    return 0


def list_hostgroups() -> int:
    """Lists all hostgroups from Zabbix."""
    res = zabbix("hostgroup.get", {"output": ["name"]})
    if not res:
        if not JSON_MODE:
            print(tr("no_groups_found"))
        return 0
    for g in sorted(res, key=lambda x: x["name"].lower()):
        if JSON_MODE:
            _row(group=g["name"])
            continue
        print(g["name"])
    return 0


## Actions

def build_reason(explicit: str = None) -> str:
    """Returns the maintenance comment; {user}/{host} placeholders resolved."""
    template = explicit if explicit is not None else CONFIG["reason"]
    try:
        return template.format(user=getpass.getuser(), host=socket.gethostname())
    except (KeyError, IndexError):
        return template  # invalid placeholders -> pass the raw text through


def _maintenance_params(name, since, till, secs, reason, hosts=None, groups=None) -> dict:
    params = {
        "name": name,
        "active_since": since,
        "active_till": till,
        "maintenance_type": 0,
        "description": reason,
        "timeperiods": [{
            "timeperiod_type": 0,
            "start_date": since,
            "period": secs,
        }],
    }
    if hosts:
        params["hosts"] = [{"hostid": hid} for hid in hosts]
    if groups:
        params["groups"] = [{"groupid": gid} for gid in groups]
    return params


def _upsert_maintenance(name, since, till, secs, reason, hosts=None, groups=None):
    """Creates a maintenance and replaces an existing one of the same name.

    Update in place (maintenance.update) rather than delete+recreate, so the
    target is never left unmuted in between if a call fails."""
    existing = get_maintenance(name)
    params = _maintenance_params(name, since, till, secs, reason, hosts, groups)
    if not existing:
        zabbix("maintenance.create", params)
        return
    # Update instead of delete+create: no unmuted window in between.
    params["maintenanceid"] = existing["maintenanceid"]
    params.pop("name", None)  # name stays unchanged
    zabbix("maintenance.update", params)


def run_snooze(duration_str, hosts, groups=None, reason=None, since=None) -> int:
    """since: scheduled start (Unix timestamp) for 'snooze plan'; None = immediately (now)."""
    groups = groups or []
    secs = parse_duration(duration_str)
    now = int(time.time())
    since = now if since is None else since
    end = since + secs
    since_label = time.strftime("%Y-%m-%d %H:%M", time.localtime(since))
    end_label = time.strftime("%Y-%m-%d %H:%M", time.localtime(end))
    status = (tr("status_planned", since=since_label, end=end_label) if since > now
              else tr("status_muted", end=end_label))
    reason = build_reason(reason)
    failed = 0

    if hosts:
        host_ids = resolve_hosts(hosts)
        for h in hosts:
            hid = host_ids.get(h)
            if not hid:
                _print_err(h, tr("not_in_zabbix"), error="not_found")
                failed += 1
                continue
            try:
                _upsert_maintenance(CONFIG["prefix"] + h, since, end, secs, reason, hosts=[hid])
                _print_ok(h, status, action="planned" if since > now else "muted",
                          maintenance=CONFIG["prefix"] + h, since=since, since_iso=_iso(since),
                          until=end, until_iso=_iso(end), reason=reason)
            except ZabbixError as exc:
                _print_err(h, str(exc), error="api_error")
                failed += 1

    if groups:
        group_ids = resolve_groups(groups)
        for g in groups:
            gid = group_ids.get(g)
            if not gid:
                _print_err(f"@{g}", tr("group_not_in_zabbix"), error="not_found")
                failed += 1
                continue
            try:
                _upsert_maintenance(CONFIG["prefix"] + "@" + g, since, end, secs, reason, groups=[gid])
                _print_ok(f"@{g}", tr("group_status", status=status),
                          action="planned" if since > now else "muted",
                          maintenance=CONFIG["prefix"] + "@" + g, since=since, since_iso=_iso(since),
                          until=end, until_iso=_iso(end), reason=reason)
            except ZabbixError as exc:
                _print_err(f"@{g}", str(exc), error="api_error")
                failed += 1

    return 1 if failed else 0


def run_extend(duration_str, hosts, groups=None) -> int:
    """Extends existing snooze windows by DURATION from their current end."""
    groups = groups or []
    secs = parse_duration(duration_str)
    now = int(time.time())
    failed = 0

    def extend_one(label, name):
        nonlocal failed
        existing = get_maintenance(name)
        if not existing:
            _print_err(label, tr("no_active_entry"), error="no_active_entry")
            failed += 1
            return
        base = max(int(existing["active_till"]), now)
        new_end = base + secs
        new_period = new_end - now
        end_label = time.strftime("%Y-%m-%d %H:%M", time.localtime(new_end))
        try:
            zabbix("maintenance.update", {
                "maintenanceid": existing["maintenanceid"],
                "active_till": new_end,
                "timeperiods": [{
                    "timeperiod_type": 0,
                    "start_date": now,
                    "period": new_period,
                }],
            })
            _print_ok(label, tr("extended_until", end=end_label), action="extended",
                      maintenance=name, maintenanceid=existing["maintenanceid"],
                      until=new_end, until_iso=_iso(new_end),
                      previous_until=int(existing["active_till"]))
        except ZabbixError as exc:
            _print_err(label, str(exc), error="api_error")
            failed += 1

    for h in hosts:
        extend_one(h, CONFIG["prefix"] + h)
    for g in groups:
        extend_one(f"@{g}", CONFIG["prefix"] + "@" + g)
    return 1 if failed else 0


def run_wakeup(hosts, groups=None) -> int:
    groups = groups or []
    failed = 0

    def wake_one(label, name):
        nonlocal failed
        existing = get_maintenance(name)
        if not existing:
            _print_err(label, tr("no_active_entry"), error="no_active_entry")
            failed += 1
            return
        try:
            zabbix("maintenance.delete", [existing["maintenanceid"]])
            _print_ok(label, tr("woken"), action="unmuted", maintenance=name,
                      maintenanceid=existing["maintenanceid"])
        except ZabbixError as exc:
            _print_err(label, str(exc), error="api_error")
            failed += 1

    for h in hosts:
        wake_one(h, CONFIG["prefix"] + h)
    for g in groups:
        wake_one(f"@{g}", CONFIG["prefix"] + "@" + g)
    return 1 if failed else 0


def _snooze_maintenances() -> list:
    """All maintenances managed by snooze (name starts with prefix)."""
    res = zabbix("maintenance.get", {
        "output": ["maintenanceid", "name", "active_since", "active_till", "description"],
        "search": {"name": CONFIG["prefix"]},
        "startSearch": True,
    })
    return [m for m in res if m["name"].startswith(CONFIG["prefix"])]


def _format_remaining(secs: int) -> str:
    """Formats remaining seconds as 'noch 1d 2h 3m'/'1d 2h 3m left', or abgelaufen/expired."""
    if secs <= 0:
        return tr("expired")
    days, secs = divmod(secs, 86400)
    hours, secs = divmod(secs, 3600)
    mins, _ = divmod(secs, 60)
    parts = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if mins or not parts:
        parts.append(f"{mins}m")
    return tr("remaining", time=" ".join(parts))


def run_status() -> int:
    """Shows already-started snooze maintenances with remaining time and reason.

    Planned, not-yet-started windows ('snooze plan') show up under 'list plans'."""
    now = int(time.time())
    items = [m for m in _snooze_maintenances() if int(m["active_since"]) <= now]
    if not items:
        if not JSON_MODE:
            print(tr("no_active_entries"))
        return 0
    for m in sorted(items, key=lambda x: x["name"].lower()):
        target = m["name"][len(CONFIG["prefix"]):]
        till = int(m["active_till"])
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(till))
        reason = m.get("description", "")
        if JSON_MODE:
            _row(target=target, maintenanceid=m["maintenanceid"], maintenance=m["name"],
                 since=int(m["active_since"]), since_iso=_iso(m["active_since"]),
                 until=till, until_iso=_iso(till), remaining=max(0, till - now),
                 expired=till <= now, reason=reason)
            continue
        suffix = f"  [{reason}]" if reason else ""
        print(f"{target:<30}{_format_remaining(till - now):<16}({tr('word_until')} {when}){suffix}")
    return 0


def run_plans() -> int:
    """Shows planned, not-yet-started snooze entries ('snooze plan')."""
    now = int(time.time())
    items = [m for m in _snooze_maintenances() if int(m["active_since"]) > now]
    if not items:
        if not JSON_MODE:
            print(tr("no_planned_entries"))
        return 0
    for m in sorted(items, key=lambda x: int(x["active_since"])):
        target = m["name"][len(CONFIG["prefix"]):]
        since = int(m["active_since"])
        till = int(m["active_till"])
        since_label = time.strftime("%Y-%m-%d %H:%M", time.localtime(since))
        till_label = time.strftime("%Y-%m-%d %H:%M", time.localtime(till))
        reason = m.get("description", "")
        if JSON_MODE:
            _row(target=target, maintenanceid=m["maintenanceid"], maintenance=m["name"],
                 since=since, since_iso=_iso(since), until=till, until_iso=_iso(till),
                 starts_in=max(0, since - now), reason=reason)
            continue
        suffix = f"  [{reason}]" if reason else ""
        print(f"{target:<30}{tr('word_starts')} {since_label:<18}{tr('word_until')} {till_label}{suffix}")
    return 0


def run_cleanup() -> int:
    """Deletes expired snooze windows (Zabbix doesn't clean them up itself)."""
    now = int(time.time())
    expired = [m for m in _snooze_maintenances() if int(m["active_till"]) <= now]
    if not expired:
        if not JSON_MODE:
            print(tr("no_expired_entries"))
        return 0
    try:
        zabbix("maintenance.delete", [m["maintenanceid"] for m in expired])
    except ZabbixError as exc:
        die(tr("cleanup_failed", exc=exc), error="api_error")
    for m in sorted(expired, key=lambda x: x["name"].lower()):
        if JSON_MODE:
            _row(target=m["name"][len(CONFIG["prefix"]):], result="ok", action="removed",
                 maintenanceid=m["maintenanceid"], maintenance=m["name"],
                 until=int(m["active_till"]), until_iso=_iso(m["active_till"]))
            continue
        print(f"{tr('removed')}  {m['name'][len(CONFIG['prefix']):]}")
    if not JSON_MODE:
        print(tr("cleanup_summary", count=len(expired)))
    return 0


## Suppressed problems (list suppressed)
#
# Zabbix marks problems on hosts in maintenance as "suppressed" rather than
# hiding them outright; problem.get(suppressed=True) still returns them, and
# selectSuppressionData reveals exactly which maintenanceid did it. That lets
# us show precisely what a given snooze window is currently suppressing —
# and what would alert again immediately on the next unmute.

SEVERITY_LABELS = {
    "de": {
        "0": "Nicht klassifiziert",
        "1": "Information",
        "2": "Warnung",
        "3": "Durchschnittlich",
        "4": "Hoch",
        "5": "Katastrophe",
    },
    "en": {
        "0": "Not classified",
        "1": "Information",
        "2": "Warning",
        "3": "Average",
        "4": "High",
        "5": "Disaster",
    },
}


def suppressed_problems(maintenanceid: str, hostids=None, groupids=None) -> list:
    """Problems currently suppressed by the given maintenance window."""
    params = {
        "output": ["eventid", "name", "severity", "clock"],
        "selectSuppressionData": ["maintenanceid", "suppress_until"],
        "suppressed": True,
    }
    if hostids:
        params["hostids"] = hostids
    if groupids:
        params["groupids"] = groupids
    res = zabbix("problem.get", params)
    matching = [
        p for p in res
        if any(s.get("maintenanceid") == maintenanceid for s in p.get("suppression_data") or [])
    ]
    return sorted(matching, key=lambda p: int(p.get("severity", 0)), reverse=True)


def _print_suppressed(label: str, maintenanceid: str, hostids=None, groupids=None):
    """Prints one line per suppressed problem, or a 'none' notice."""
    problems = suppressed_problems(maintenanceid, hostids=hostids, groupids=groupids)
    if JSON_MODE:
        _row(target=label, maintenanceid=maintenanceid, count=len(problems), problems=[
            {
                "eventid": p.get("eventid"),
                "name": p.get("name"),
                "severity": int(p.get("severity", 0)),
                "severity_label": SEVERITY_LABELS["en"].get(str(p.get("severity")), ""),
                "clock": int(p["clock"]),
                "clock_iso": _iso(p["clock"]),
            }
            for p in problems
        ])
        return
    if not problems:
        print(f"{label}  {tr('no_suppressed')}")
        return
    for p in problems:
        sev = SEVERITY_LABELS[LANG].get(str(p.get("severity")), p.get("severity"))
        since = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(p["clock"])))
        print(f"{label}  [{sev}]  {p['name']}  {tr('word_since')} {since}")


def run_suppressed(hosts, groups=None) -> int:
    """Shows problems currently suppressed by snooze windows.

    Without targets: all windows managed by snooze (expired ones then simply
    show no more suppressed problems, same as with 'list active')."""
    groups = groups or []
    failed = 0

    if not hosts and not groups:
        items = sorted(_snooze_maintenances(), key=lambda x: x["name"].lower())
        if not items:
            if not JSON_MODE:
                print(tr("no_active_entries"))
            return 0
        targets = [m["name"][len(CONFIG["prefix"]):] for m in items]
        host_names = [t for t in targets if not t.startswith("@")]
        group_names = [t[1:] for t in targets if t.startswith("@")]
        host_ids = resolve_hosts(host_names) if host_names else {}
        group_ids = resolve_groups(group_names) if group_names else {}
        for m, target in zip(items, targets):
            if target.startswith("@"):
                gid = group_ids.get(target[1:])
                _print_suppressed(target, m["maintenanceid"], groupids=[gid] if gid else None)
            else:
                hid = host_ids.get(target)
                _print_suppressed(target, m["maintenanceid"], hostids=[hid] if hid else None)
        return 0

    if hosts:
        host_ids = resolve_hosts(hosts)
        for h in hosts:
            hid = host_ids.get(h)
            if not hid:
                _print_err(h, tr("not_in_zabbix"), error="not_found")
                failed += 1
                continue
            existing = get_maintenance(CONFIG["prefix"] + h)
            if not existing:
                _print_err(h, tr("no_active_entry"), error="no_active_entry")
                failed += 1
                continue
            _print_suppressed(h, existing["maintenanceid"], hostids=[hid])

    if groups:
        group_ids = resolve_groups(groups)
        for g in groups:
            gid = group_ids.get(g)
            if not gid:
                _print_err(f"@{g}", tr("group_not_in_zabbix"), error="not_found")
                failed += 1
                continue
            existing = get_maintenance(CONFIG["prefix"] + "@" + g)
            if not existing:
                _print_err(f"@{g}", tr("no_active_entry"), error="no_active_entry")
                failed += 1
                continue
            _print_suppressed(f"@{g}", existing["maintenanceid"], groupids=[gid])

    return 1 if failed else 0


## Target collection (arguments, -F file, stdin)

def read_targets_file(path: str) -> list:
    """Reads targets (one token per line, # = comment) from a file or stdin (-)."""
    if path == "-":
        text = sys.stdin.read()
    else:
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        except OSError as exc:
            die(tr("file_unreadable", path=path, exc=exc))
    out = []
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            out.extend(line.split())
    return out


def confirm(count: int, yes: bool) -> bool:
    """Confirmation prompt for many targets; skipped with -Y/--yes."""
    threshold = int(CONFIG["confirm_threshold"])
    if yes or count <= threshold:
        return True
    if JSON_MODE or not sys.stdin.isatty():
        die(tr("confirm_need_yes", count=count, threshold=threshold), code=2)
    answer = input(tr("confirm_prompt", count=count)).strip().lower()
    return answer in ("j", "ja", "y", "yes")


